    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@cloudflare/vite-plugin": "^1.40.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.20",
